# Copiá este archivo como .env y ajustá los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# URL base de la API
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# API key (PokeAPI no la requiere; dejar vacío). Si usás una API que la pida,
# poné acá tu token: nunca lo escribas directamente en el código.
API_KEY=

# Cantidad de Pokémon a extraer y desde qué posición (151 = primera generación)
POKEMON_LIMIT=151
POKEMON_OFFSET=0

# Segundos máximos de espera por petición y reintentos ante errores 429/5xx
REQUEST_TIMEOUT=10
MAX_RETRIES=3

# Carpeta de salida, relativa a la raíz del repositorio ("." = raíz)
OUTPUT_DIR=.
